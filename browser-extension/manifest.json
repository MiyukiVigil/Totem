{
  "manifest_version": 3,
  "name": "Totem",
  "version": "0.1.0",
  "description": "Fill 2FA codes from your phone, through Totem for Windows. The secrets never leave the phone.",
  "key": "",
  "minimum_chrome_version": "127",
  "permissions": ["nativeMessaging", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Totem: fill a 2FA code",
    "default_icon": { "32": "icons/32.png", "64": "icons/64.png" }
  },
  "icons": { "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "Open Totem" }
  }
}
