<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug only: open a pairing code with adb instead of the camera:
             adb shell am start -a android.intent.action.VIEW -d "totem://pair?..."
             (Not in release builds: a link must never be able to start pairing.) -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="totem" android:host="pair" />
            </intent-filter>
        </activity>
    </application>
</manifest>
